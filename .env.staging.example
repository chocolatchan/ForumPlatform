# =============================================================================
# Forum Platform Staging Environment Configuration Template
# Use this template for deploying to staging environments.
# ALL VALUES HERE MUST BE PROVIDED AS SECURE, NON-DEFAULT SECRETS IN STAGING.
# =============================================================================

# Environment & Server
ENVIRONMENT=staging
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=staging-random-session-secret-key-minimum-32-chars-long

# PostgreSQL Infrastructure (Separate Logical Databases per Service)
POSTGRES_USER=staging_forum_admin
POSTGRES_PASSWORD=staging_unique_strong_postgres_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service Database Connection URLs
DATABASE_USERS_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_users
DATABASE_CONTENT_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_content
DATABASE_INTERACTIONS_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_interactions
DATABASE_MODERATION_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_moderation
DATABASE_NOTIFICATIONS_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_notifications
DATABASE_SEARCH_URL=postgresql+asyncpg://staging_forum_admin:staging_unique_strong_postgres_password_2026@postgres:5432/forum_search

# Redis Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Object Storage / Uploads
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/uploads
STORAGE_MAX_FILE_SIZE_BYTES=2097152

# Security & Session Settings
SESSION_COOKIE_NAME=forum_session
SESSION_IDLE_TIMEOUT_SECONDS=14400
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
CSRF_SECRET=staging-cryptographically-secure-csrf-secret-key-32chars

# Abuse Controls & Rate Limiting
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_VERIFY_OTP_MAX=15
RATE_LIMIT_RESEND_OTP_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Email Provider Configuration (Task 031.3.H)
# This staging sample uses the shared Compose stack, which pins the non-production
# transport to the Mailpit service: host mailpit, internal SMTP port 1025, plain
# SMTP, and no credentials. Port 8025 is the host-published Mailpit UI/API only.
# Production external delivery must use a separate deployment configuration with
# its own SMTP_* host and credentials; never reuse these non-production values.
# The per-container SMTP egress guard is skipped in staging/production; it is
# active only for ENVIRONMENT=development or test.
EMAIL_DELIVERY_BACKEND=smtp
DEV_SMTP_HOST=mailpit
DEV_SMTP_PORT=1025
DEV_SMTP_USER=
DEV_SMTP_PASSWORD=
DEV_SMTP_USE_TLS=false
DEV_SMTP_STARTTLS=false
EMAIL_FROM=noreply-staging@forumplatform.internal
MAILPIT_UI_PORT=8025

# Inter-Service Authentication & Proxy Trust (ADR-003, Task 013)
# Replace this example value before deployment; staging validation rejects it.
INTERNAL_SERVICE_SECRET=staging-internal-service-secret-must-be-32-chars-long
# Must remain false in staging; enabling the bypass is rejected.
INTERNAL_SERVICE_AUTH_BYPASS=false
TRUSTED_PROXIES=127.0.0.1,::1,gateway
