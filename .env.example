# =============================================================================
# Forum Platform Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# ALL VALUES IN THIS TEMPLATE ARE SAFE PLACEHOLDERS - DO NOT PUT REAL SECRETS HERE.
# =============================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# PostgreSQL Infrastructure (DEC-002: Separate Logical Databases per Service)
POSTGRES_USER=forum_admin
POSTGRES_PASSWORD=forum_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Service Database Connection URLs
DATABASE_USERS_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_users
DATABASE_CONTENT_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_content
DATABASE_INTERACTIONS_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_interactions
DATABASE_MODERATION_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_moderation
DATABASE_NOTIFICATIONS_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_notifications
DATABASE_SEARCH_URL=postgresql+asyncpg://forum_admin:forum_dev_password@localhost:5432/forum_search

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage / Uploads (ADR-006)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=2097152

# Security & Session Settings (ADR-003, ADR-004)
SESSION_COOKIE_NAME=forum_session
SESSION_IDLE_TIMEOUT_SECONDS=14400
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
CSRF_SECRET=replace-with-random-csrf-secret-key

# Abuse Controls & Rate Limiting (Task 007)
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_VERIFY_OTP_MAX=15
RATE_LIMIT_RESEND_OTP_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Email Provider & SMTP Catcher (Task 006.5 / Task 031.3.H)
# Development/test delivery uses the Mailpit container over the Compose network.
# docker-compose.yml pins the non-production transport to Mailpit and maps only
# the DEV_SMTP_* variables below, so production SMTP_* host and credential values
# are never passed to development/test containers.
# Production must use a separate deployment configuration with its own SMTP_HOST,
# SMTP_PORT, SMTP_USER, and SMTP_PASSWORD; Mailpit and loopback SMTP hosts are
# rejected by the application in production.
# In development/test, the User and Notification containers also apply a
# per-container outbound guard: only mailpit:1025 is allowed on SMTP ports
# 25/465/587/1025/2525; DNS, loopback, established traffic, and non-SMTP ports
# remain available. Staging/production skip the guard. See
# docs/operations/smtp_egress_guard_runbook.md.
EMAIL_DELIVERY_BACKEND=smtp
DEV_SMTP_HOST=mailpit
DEV_SMTP_PORT=1025
DEV_SMTP_USER=
DEV_SMTP_PASSWORD=
DEV_SMTP_USE_TLS=false
DEV_SMTP_STARTTLS=false
EMAIL_FROM=noreply@forumplatform.local
# Development/test per-container SMTP egress guard. Keep the allowed target on
# Mailpit; the guard is skipped in staging/production.
SMTP_GUARD_ALLOWED_HOST=mailpit
SMTP_GUARD_ALLOWED_PORT=1025
SMTP_GUARD_PORTS="25 465 587 1025 2525"
# Task 031.1: seconds before a 'sending' EmailDelivery row is treated as an orphaned lease
EMAIL_WORKER_LEASE_TIMEOUT_SECONDS=300
MAILPIT_UI_PORT=8025

# Internal Microservice Authentication & Proxy Trust (ADR-003, Task 013)
# Required in every environment. Staging/production reject documented example values.
INTERNAL_SERVICE_SECRET=replace-with-secure-internal-secret-min-32-chars
# Explicit local/test-only bypass for a missing internal header. ENVIRONMENT must be
# explicitly set to development or test; missing or other environments reject this.
INTERNAL_SERVICE_AUTH_BYPASS=false
TRUSTED_PROXIES=127.0.0.1,::1,gateway
